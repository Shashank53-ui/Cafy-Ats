# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# non-sync local python scraper workspace
# Allow tracking backend_scrape except for virtual environments, caches, database files, and local envs
!backend_scrape/
backend_scrape/venv/
backend_scrape/.venv/
backend_scrape/__pycache__/
backend_scrape/**/__pycache__/
*.pyc
backend_scrape/.env
backend_scrape/ats_database.csv
backend_scrape/ats_database.json


