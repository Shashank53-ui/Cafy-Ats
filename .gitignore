# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# non-sync local python scraper workspace
# Allow tracking backend_scrape except for virtual environments, caches, database files, and local envs
!backend_scrape/
backend_scrape/venv/
backend_scrape/.venv/
backend_scrape/__pycache__/
backend_scrape/**/__pycache__/
*.pyc
backend_scrape/.env
backend_scrape/ats_database.csv
backend_scrape/ats_database.json

storage/

# sync pipeline debug output (regenerated by syncAll)
logs/
rejection_log.json

# local scratch / one-off agent dumps (never commit)
tmp-*
src/scripts/_tmp*
data/sponsors_missing_jobs_ids.txt

# one-off audits / backfills / local dumps (not part of sync)
src/scripts/auditSectorQuality.ts
src/scripts/backfillJobSectors.ts
src/scripts/reclassifyJobSectors.ts
src/lib/classifyJobTaxonomy.test.ts
supabase/constrain_job_taxonomy.sql
docs/ats_providers_and_custom_scrapers.csv

# local-only test fixtures
data/excel/

# supabase CLI local cache
supabase/.temp/

# Windows alternate-data-stream markers from downloaded files
*Zone.Identifier*
